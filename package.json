{
  "name": "pi-durable-replay",
  "version": "0.87.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run clean && vite build",
    "clean": "shx rm -rf .wrangler dist",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "oxfmt --check . && wrangler types --env-file .dev.vars.example --include-runtime false --check && tsc && tsc -p tsconfig.client.json && bun run build && wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "deploy": "bun run build && wrangler deploy",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest --run",
    "demo:local-kill": "bash scripts/local-kill-demo.sh"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.38",
    "@assistant-ui/react-markdown": "0.14.26",
    "@earendil-works/chord": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@earendil-works/pi-durable": "1.6.0",
    "@earendil-works/pi-schema": "1.6.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.78.0",
    "partysocket": "1.3.0",
    "radix-ui": "1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.68.0",
    "@cloudflare/vitest-plugin": "1.6.1",
    "@cloudflare/workers-types": "5.20261109.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxfmt": "0.78.0",
    "shx": "0.4.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vite": "^8.3.7",
    "vitest": "5.1.0",
    "wrangler": "4.159.0"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
